{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mentor:parental-v2.0:native-display",
  "title": "native-display",
  "type": "object",
  "properties": {
    "role": {
      "enum": [
        "unconfigured",
        "guardian",
        "child"
      ]
    },
    "guardianAuthenticated": {
      "type": "boolean"
    },
    "profile": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "age": {
              "type": "integer",
              "minimum": 10,
              "maximum": 15
            },
            "profile": {
              "enum": [
                "10-12",
                "13-15"
              ]
            },
            "policyVersion": {
              "const": "age-10-15-v1"
            },
            "policyRevision": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$"
            }
          },
          "required": [
            "age",
            "profile",
            "policyVersion",
            "policyRevision"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "pairing": {
      "enum": [
        "unpaired",
        "pending",
        "paired",
        "revoked",
        "key_lost"
      ]
    },
    "health": {
      "type": "object",
      "properties": {
        "accessibility": {
          "type": "boolean"
        },
        "companion": {
          "enum": [
            "connected",
            "disconnected",
            "legacy"
          ]
        },
        "analysis": {
          "enum": [
            "ready",
            "unknown",
            "failed",
            "unconfigured"
          ]
        },
        "execution": {
          "enum": [
            "ready",
            "degraded",
            "locked"
          ]
        },
        "encryption": {
          "enum": [
            "ready",
            "locked",
            "failed"
          ]
        },
        "cloud": {
          "enum": [
            "online",
            "offline",
            "unconfigured",
            "auth_error"
          ]
        },
        "outboxCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        }
      },
      "required": [
        "accessibility",
        "companion",
        "analysis",
        "execution",
        "encryption",
        "cloud",
        "outboxCount"
      ],
      "additionalProperties": false
    },
    "activeProtection": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "eventId": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "stage": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            },
            "explanationKey": {
              "enum": [
                "calm_younger",
                "calm_older"
              ]
            },
            "canNavigateHome": {
              "type": "boolean"
            }
          },
          "required": [
            "eventId",
            "stage",
            "explanationKey",
            "canNavigateHome"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z_]{1,64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "role",
    "guardianAuthenticated",
    "profile",
    "pairing",
    "health",
    "activeProtection",
    "error"
  ],
  "additionalProperties": false
}
