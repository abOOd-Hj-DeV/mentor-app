{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mentor:parental-v2.0:pairing",
  "title": "pairing",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "v": {
          "const": 2
        },
        "type": {
          "const": "pair_offer"
        },
        "pair_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "nonce_b64": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "expires_at_ms": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "guardian": {
          "type": "object",
          "properties": {
            "device_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "auth_uid": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9:_-]{1,128}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "hpke_public_keyset_b64": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$",
              "maxLength": 1366
            },
            "hpke_kid": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "signing_public_spki_b64": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$",
              "maxLength": 171
            },
            "signing_kid": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "device_id",
            "auth_uid",
            "hpke_public_keyset_b64",
            "hpke_kid",
            "signing_public_spki_b64",
            "signing_kid"
          ],
          "additionalProperties": false
        },
        "signature_b64": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "maxLength": 96
        }
      },
      "required": [
        "v",
        "type",
        "pair_id",
        "nonce_b64",
        "expires_at_ms",
        "guardian",
        "signature_b64"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "v": {
          "const": 2
        },
        "type": {
          "const": "pair_response"
        },
        "pair_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "offer_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "child": {
          "type": "object",
          "properties": {
            "device_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "auth_uid": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9:_-]{1,128}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "hpke_public_keyset_b64": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$",
              "maxLength": 1366
            },
            "hpke_kid": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "signing_public_spki_b64": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$",
              "maxLength": 171
            },
            "signing_kid": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "device_id",
            "auth_uid",
            "hpke_public_keyset_b64",
            "hpke_kid",
            "signing_public_spki_b64",
            "signing_kid"
          ],
          "additionalProperties": false
        },
        "signature_b64": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "maxLength": 96
        }
      },
      "required": [
        "v",
        "type",
        "pair_id",
        "offer_sha256",
        "child",
        "signature_b64"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "v": {
          "const": 2
        },
        "type": {
          "const": "pair_confirm"
        },
        "pair_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "offer_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "response_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "signature_b64": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "maxLength": 96
        }
      },
      "required": [
        "v",
        "type",
        "pair_id",
        "offer_sha256",
        "response_sha256",
        "signature_b64"
      ],
      "additionalProperties": false
    }
  ]
}
