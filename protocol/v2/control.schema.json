              "enum": [
                "unsupported_version",
                "malformed_json",
                "bounds",
                "invalid_age",
                "policy_mismatch",
                "session_mismatch",
                "stream_mismatch",
                "stale",
                "future_pts",
                "clock_unverified",
                "wrong_screen",
                "invalid_transform",
                "invalid_scores",
                "invalid_evidence",
                "hentai_stage3_forbidden",
                "capability_missing",
                "permission_missing",
                "locked",
                "action_failed",
                "home_unverified",
                "event_conflict",
                "rate_limited",
                "busy",
                "storage_failed"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "policy_revision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$"
        }
