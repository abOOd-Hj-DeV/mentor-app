{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mentor:parental-v2.0:control",
  "title": "control",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "v": {
          "const": 2
        },
        "type": {
          "const": "control"
        },
        "command_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "control_revision": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "issued_at_ms": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "expires_at_ms": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "challenge": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "nonce_b64": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{43}$"
                }
              },
              "required": [
                "id",
                "nonce_b64"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "operation": {
          "const": "set_profile"
        },
        "profile": {
          "type": "object",
          "properties": {
            "age": {
              "type": "integer",
              "minimum": 10,
              "maximum": 15
            },
            "policy_version": {
              "const": "age-10-15-v1"
            }
          },
          "required": [
            "age",
            "policy_version"
          ],
          "additionalProperties": false
        },
        "grant": {
          "type": "null"
        }
      },
      "required": [
        "v",
        "type",
        "command_id",
        "control_revision",
        "issued_at_ms",
        "expires_at_ms",
        "challenge",
        "operation",
        "profile",
        "grant"
      ],
      "additionalProperties": false
    },
